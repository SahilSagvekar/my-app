@@ -17,7 +17,7 @@ const crypto = require('crypto');
 const { spawn } = require('child_process');
 const ffmpegPath = require('ffmpeg-static');
 
-const { GetObjectCommand } = require('@aws-sdk/client-s3');
+const { GetObjectCommand, ListObjectsV2Command } = require('@aws-sdk/client-s3');
 const { BUCKET, getS3, putObject } = require('./s3');
 
 const RAW_FOOTAGE_SEGMENT = 'raw-footage';
@@ -45,6 +45,69 @@ function shouldThumbnail(key) {
   return isVideoKey(key) && isRawFootageKey(key);
 }
 
+// ── Task-output video thumbnails ──────────────────────────────────────────
+// Separate from raw-footage above (which always thumbnails). Outputs only
+// get an auto-thumbnail when the task has no real thumbnail image already —
+// generating one is wasted ffmpeg work if an editor already uploaded a
+// proper thumbnail into the task's thumbnails/ subfolder.
+
+const OUTPUTS_SEGMENT = 'outputs';
+const MAIN_SEGMENT = 'main';
+const IMAGE_EXTENSIONS = new Set(['jpg', 'jpeg', 'png', 'webp']);
+
+/** Matches {company}/outputs/{month}/{taskTitle}/main/{video-file} */
+function isOutputMainVideoKey(key) {
+  if (!isVideoKey(key)) return false;
+  const parts = key.split('/').filter(Boolean);
+  if (parts.length < 2) return false;
+  const ancestors = parts.slice(0, -1); // exclude filename
+  return ancestors.includes(OUTPUTS_SEGMENT) && ancestors[ancestors.length - 1] === MAIN_SEGMENT;
+}
+
+/** {a}/{b}/main/{file}.mp4 -> {a}/{b}/thumbnails/ */
+function siblingThumbnailsFolder(mainVideoKey) {
+  const parts = mainVideoKey.split('/').filter(Boolean);
+  parts.pop(); // drop filename
+  parts.pop(); // drop 'main'
+  parts.push('thumbnails');
+  return parts.join('/') + '/';
+}
+
+/** True if a real (non-auto-generated) thumbnail image already exists for
+ *  this task — checked by listing the sibling thumbnails/ folder for any
+ *  image file, since e8-file-server intentionally has no DB access to check
+ *  the app's own `file` records directly. */
+async function hasExistingThumbnailImage(mainVideoKey) {
+  const s3 = getS3();
+  const prefix = siblingThumbnailsFolder(mainVideoKey);
+  const res = await s3.send(new ListObjectsV2Command({
+    Bucket: BUCKET,
+    Prefix: prefix,
+    MaxKeys: 50, // small folder, just need to know if ANY image is in it
+  }));
+  const contents = res.Contents || [];
+  return contents.some((obj) => {
+    if (!obj.Key || obj.Key === prefix) return false; // skip the folder marker itself
+    const ext = obj.Key.split('.').pop()?.toLowerCase();
+    return IMAGE_EXTENSIONS.has(ext || '');
+  });
+}
+
+/** Safety net: if anything in the eligibility check itself throws (a bad R2
+ *  call, a malformed key, etc.), treat it as "not eligible" rather than
+ *  letting the error propagate — this function is called from the upload
+ *  completion path, and a thumbnail eligibility check must never be able to
+ *  fail an actual upload. */
+async function shouldThumbnailOutput(key) {
+  try {
+    if (!isOutputMainVideoKey(key)) return false;
+    return !(await hasExistingThumbnailImage(key));
+  } catch (err) {
+    console.error(`[Thumbnail] shouldThumbnailOutput check failed for ${key} — treating as not eligible:`, err.message);
+    return false;
+  }
+}
+
 function thumbnailKeyFor(sourceKey) {
   return `${THUMBNAIL_PREFIX}${sourceKey}.jpg`;
 }
@@ -132,7 +195,7 @@ async function generateThumbnail(key) {
     const jpegBuffer = fs.readFileSync(outTmp);
     const destKey = thumbnailKeyFor(key);
     await putObject(destKey, jpegBuffer, 'image/jpeg');
-    return destKey;
+    return { destKey, sizeBytes: jpegBuffer.length };
   } finally {
     safeUnlink(srcTmp);
     safeUnlink(outTmp);
@@ -143,6 +206,9 @@ module.exports = {
