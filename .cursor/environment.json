{
  "name": "E8 Productions",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "ports": [
    {
      "name": "next-dev",
      "port": 3000
    }
  ],
  "terminals": [
    {
      "name": "next-dev",
      "command": "npm run dev -- --hostname 0.0.0.0 --port 3000",
      "description": "Next.js development server"
    }
  ]
}
