name = "e8-app"
compatibility_date = "2026-08-04"
compatibility_flags = ["nodejs_compat"]

account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

# ---------- R2 bucket binding ----------
[[r2_buckets]]
binding = "R2_VIDEOS"
bucket_name = "e8-app-r2-prod"

# ---------- Queues (short async jobs) ----------
[[queues.producers]]
queue = "commission-payouts"
binding = "COMMISSION_QUEUE"

[[queues.consumers]]
queue = "commission-payouts"
max_batch_size = 10

[[queues.producers]]
queue = "scheduler-activity-rollup"
binding = "ROLLUP_QUEUE"

[[queues.consumers]]
queue = "scheduler-activity-rollup"
max_batch_size = 10

# ---------- Cron triggers (short jobs, <30s CPU) ----------
[triggers]
crons = [
  "0 9 * * *",   # auto-invoice — daily 9am
  "0 0 * * *"    # enforce-portal-locks — daily midnight
]

# ---------- Production environment ----------
[env.production]
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"
routes = [
  { pattern = "api.e8productions.com/*", zone_id = "YOUR_ZONE_ID" }
]

# ---------- Staging environment (test here first, never touches live domain) ----------
[env.staging]
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"
routes = [
  { pattern = "staging-api.e8productions.com/*", zone_id = "YOUR_ZONE_ID" }
]

# NOTE — jobs staying on EC2 (exceed 30s Worker CPU limit):
#   - s3-to-nas (2-10 min file transfer)
#   - commission-payouts-reconcile (~30-40s DB audit)
# These keep running on a t3.micro EC2 instance. Do not migrate.
